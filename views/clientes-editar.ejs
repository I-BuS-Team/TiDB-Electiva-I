<%- include('partials-head') %>

<h1>Editar cliente</h1>

<div class="form-box">
  <form method="POST" action="/clientes/editar/<%= cliente.id %>">
    <input type="text" name="nombre" value="<%= cliente.nombre %>" placeholder="Nombre" required><br>
    <input type="email" name="email" value="<%= cliente.email %>" placeholder="Email"><br>
    <input type="tel" name="telefono" value="<%= cliente.telefono %>" placeholder="Teléfono" pattern="[0-9]+" min="0" oninput="if(this.value < 0) this.value = '';"><br>
    <button type="submit">Guardar cambios</button>
    <a href="/clientes"><button type="button">Cancelar</button></a>
  </form>
</div>

</body>
</html>
