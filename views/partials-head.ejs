<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Tienda App</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; color: #222; }
    nav a { margin-right: 15px; text-decoration: none; color: #2563eb; font-weight: bold; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { border: 1px solid #ddd; padding: 8px 10px; text-align: left; }
    th { background: #f3f4f6; }
    th:last-child, td:last-child { white-space: nowrap; }
    form.inline { display: inline-block; }
    input, select { padding: 6px; margin: 4px 4px 4px 0; }
    button { padding: 6px 14px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; }
    button.danger { background: #dc2626; }
    .form-box { background: #f9fafb; padding: 16px; border-radius: 8px; margin-top: 20px; }
  </style>
</head>
<body>
  <nav>
    <a href="/">Inicio</a>
    <a href="/clientes">Clientes</a>
    <a href="/productos">Productos</a>
    <a href="/pedidos">Pedidos</a>
  </nav>
  <hr>
