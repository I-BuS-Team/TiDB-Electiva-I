<%- include('partials-head') %>

<h1>Productos</h1>

<table>
  <tr>
    <th>ID</th><th>Nombre</th><th>Precio</th><th>Stock</th><th></th>
  </tr>
  <% productos.forEach(p => { %>
  <tr>
    <td><%= p.id %></td>
    <td><%= p.nombre %></td>
    <td>$<%= p.precio %></td>
    <td><%= p.stock %></td>
    <td>
      <a href="/productos/editar/<%= p.id %>"><button type="button">Editar</button></a>
      <form class="inline" method="POST" action="/productos/eliminar/<%= p.id %>">
        <button class="danger" type="submit">Eliminar</button>
      </form>
    </td>
  </tr>
  <% }) %>
</table>

<div class="form-box">
  <h3>Agregar producto</h3>
  <form method="POST" action="/productos">
    <input type="text" name="nombre" placeholder="Nombre" required>
    <input type="number" step="0.01" min="0" name="precio" placeholder="Precio" required>
    <input type="number" min="0" name="stock" placeholder="Stock" required>
    <button type="submit">Guardar</button>
  </form>
</div>

</body>
</html>
